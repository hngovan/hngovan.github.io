---
import 'lightgallery/css/lg-rotate.css'
import 'lightgallery/css/lg-zoom.css'
import 'lightgallery/css/lightgallery.css'
---

<div id="content-lightbox-root" class="hidden"></div>

<script>
	import lightGallery from 'lightgallery'
	import lgRotate from 'lightgallery/plugins/rotate'
	import lgZoom from 'lightgallery/plugins/zoom'

	const IMAGE_SELECTOR = '[data-lightbox-image], [data-content-lightbox] img'
	const LIGHTBOX_ROOT_ID = 'content-lightbox-root'
	const PAGE_SCROLL_LOCK_CLASS = 'keeb-log-lightbox-open'

	let restorePageScroll: (() => void) | null = null
	let wheelZoomCleanup: (() => void) | null = null

	const escapeHtml = (value: string) =>
		value
			.replaceAll('&', '&amp;')
			.replaceAll('<', '&lt;')
			.replaceAll('>', '&gt;')
			.replaceAll('"', '&quot;')
			.replaceAll("'", '&#039;')

	const getCaption = (image: HTMLImageElement) => {
		const figure = image.closest('figure')
		const caption = figure?.querySelector('figcaption')?.textContent?.trim()

		return caption || image.alt || ''
	}

	const getImageUrl = (image: HTMLImageElement) =>
		image.currentSrc || image.src || image.getAttribute('src') || ''

	const lockPageScroll = () => {
		if (restorePageScroll) return

		const scrollY = window.scrollY
		const { body, documentElement } = document
		const previousStyles = {
			bodyOverflow: body.style.overflow,
			bodyOverscrollBehavior: body.style.overscrollBehavior,
			bodyPosition: body.style.position,
			bodyTop: body.style.top,
			bodyWidth: body.style.width,
			htmlOverflow: documentElement.style.overflow,
			htmlOverscrollBehavior: documentElement.style.overscrollBehavior
		}

		body.classList.add(PAGE_SCROLL_LOCK_CLASS)
		documentElement.style.overflow = 'hidden'
		documentElement.style.overscrollBehavior = 'none'
		body.style.overflow = 'hidden'
		body.style.overscrollBehavior = 'none'
		body.style.position = 'fixed'
		body.style.top = `-${scrollY}px`
		body.style.width = '100%'

		restorePageScroll = () => {
			body.classList.remove(PAGE_SCROLL_LOCK_CLASS)
			documentElement.style.overflow = previousStyles.htmlOverflow
			documentElement.style.overscrollBehavior =
				previousStyles.htmlOverscrollBehavior
			body.style.overflow = previousStyles.bodyOverflow
			body.style.overscrollBehavior = previousStyles.bodyOverscrollBehavior
			body.style.position = previousStyles.bodyPosition
			body.style.top = previousStyles.bodyTop
			body.style.width = previousStyles.bodyWidth
			window.scrollTo(0, scrollY)
			restorePageScroll = null
		}
	}

	const unlockPageScroll = () => {
		restorePageScroll?.()
	}

	const enableWheelZoom = () => {
		if (wheelZoomCleanup) return

		const handleWheel = (event: WheelEvent) => {
			if (!document.body.classList.contains(PAGE_SCROLL_LOCK_CLASS)) return

			event.preventDefault()
			event.stopPropagation()

			const zoomButtonSelector =
				event.deltaY < 0 ? '.lg-zoom-in' : '.lg-zoom-out'
			document.querySelector<HTMLButtonElement>(zoomButtonSelector)?.click()
		}

		document.addEventListener('wheel', handleWheel, {
			capture: true,
			passive: false
		})

		wheelZoomCleanup = () => {
			document.removeEventListener('wheel', handleWheel, { capture: true })
			wheelZoomCleanup = null
		}
	}

	const disableWheelZoom = () => {
		wheelZoomCleanup?.()
	}

	const initContentLightbox = () => {
		window.__keebLogContentLightbox?.destroy?.()

		const root = document.getElementById(LIGHTBOX_ROOT_ID)
		if (!root) return

		const images = Array.from(
			document.querySelectorAll<HTMLImageElement>(IMAGE_SELECTOR)
		).filter(image => {
			if (!getImageUrl(image)) return false
			if (image.closest('[data-lightbox-ignore]')) return false
			if (image.closest('a, button')) return false

			return true
		})

		if (images.length === 0) return

		const dynamicEl = images.map(image => {
			const caption = getCaption(image)
			const imageUrl = getImageUrl(image)

			return {
				src: imageUrl,
				thumb: imageUrl,
				subHtml: caption
					? `<div class="lg-caption">${escapeHtml(caption)}</div>`
					: ''
			}
		})

		const gallery = lightGallery(root, {
			actualSize: true,
			closable: true,
			controls: true,
			counter: true,
			download: false,
			dynamic: true,
			dynamicEl,
			licenseKey: '0000-0000-000-0000',
			plugins: [lgZoom, lgRotate],
			rotate: true,
			scale: 0.5,
			selector: '',
			showZoomInOutIcons: true,
			speed: 250,
			zoom: true
		})

		const handleBeforeOpen = () => {
			lockPageScroll()
			enableWheelZoom()
		}

		const handleAfterClose = () => {
			disableWheelZoom()
			unlockPageScroll()
		}

		root.addEventListener('lgBeforeOpen', handleBeforeOpen)
		root.addEventListener('lgAfterClose', handleAfterClose)

		const cleanups = images.map((image, index) => {
			image.classList.add('cursor-zoom-in')
			image.setAttribute('tabindex', '0')
			image.setAttribute('role', 'button')
			image.setAttribute(
				'aria-label',
				image.alt ? `Phóng to ảnh: ${image.alt}` : 'Phóng to ảnh'
			)

			const openGallery = (event: MouseEvent | KeyboardEvent) => {
				event.preventDefault()
				gallery.openGallery(index)
			}

			const handleKeydown = (event: KeyboardEvent) => {
				if (event.key !== 'Enter' && event.key !== ' ') return
				openGallery(event)
			}

			image.addEventListener('click', openGallery)
			image.addEventListener('keydown', handleKeydown)

			return () => {
				image.classList.remove('cursor-zoom-in')
				image.removeAttribute('tabindex')
				image.removeAttribute('role')
				image.removeAttribute('aria-label')
				image.removeEventListener('click', openGallery)
				image.removeEventListener('keydown', handleKeydown)
			}
		})

		window.__keebLogContentLightbox = {
			destroy() {
				root.removeEventListener('lgBeforeOpen', handleBeforeOpen)
				root.removeEventListener('lgAfterClose', handleAfterClose)
				disableWheelZoom()
				unlockPageScroll()
				cleanups.forEach(cleanup => cleanup())
				gallery.destroy()
			}
		}
	}

	document.addEventListener('astro:page-load', initContentLightbox)
	initContentLightbox()

	declare global {
		interface Window {
			__keebLogContentLightbox?: {
				destroy: () => void
			}
		}
	}
</script>
