---
import { Icon } from 'astro-icon/components'
import { cva, type VariantProps } from 'class-variance-authority'

import { cn } from '@/lib/utils'

const calloutConfig = {
	note: {
		style: 'border-blue-500/40 bg-blue-500/10',
		textColor: 'text-blue-700 dark:text-blue-300',
		icon: 'lucide:info'
	},
	tip: {
		style: 'border-green-500/40 bg-green-500/10',
		textColor: 'text-green-700 dark:text-green-300',
		icon: 'lucide:lightbulb'
	},
	warning: {
		style: 'border-amber-500/40 bg-amber-500/10',
		textColor: 'text-amber-700 dark:text-amber-300',
		icon: 'lucide:alert-triangle'
	},
	danger: {
		style: 'border-red-500/40 bg-red-500/10',
		textColor: 'text-red-700 dark:text-red-300',
		icon: 'lucide:shield-alert'
	},
	important: {
		style: 'border-purple-500/40 bg-purple-500/10',
		textColor: 'text-purple-700 dark:text-purple-300',
		icon: 'lucide:message-square-warning'
	},
	definition: {
		style: 'border-purple-500/40 bg-purple-500/10',
		textColor: 'text-purple-700 dark:text-purple-300',
		icon: 'lucide:book-open'
	},
	theorem: {
		style: 'border-teal-500/40 bg-teal-500/10',
		textColor: 'text-teal-700 dark:text-teal-300',
		icon: 'lucide:check-circle'
	},
	lemma: {
		style: 'border-sky-400/40 bg-sky-400/10',
		textColor: 'text-sky-700 dark:text-sky-300',
		icon: 'lucide:puzzle'
	},
	proof: {
		style: 'border-gray-500/40 bg-gray-500/10',
		textColor: 'text-gray-700 dark:text-gray-300',
		icon: 'lucide:check-square'
	},
	corollary: {
		style: 'border-cyan-500/40 bg-cyan-500/10',
		textColor: 'text-cyan-700 dark:text-cyan-300',
		icon: 'lucide:git-branch'
	},
	proposition: {
		style: 'border-slate-500/40 bg-slate-500/10',
		textColor: 'text-slate-700 dark:text-slate-300',
		icon: 'lucide:file-text'
	},
	axiom: {
		style: 'border-violet-600/40 bg-violet-600/10',
		textColor: 'text-violet-700 dark:text-violet-300',
		icon: 'lucide:anchor'
	},
	conjecture: {
		style: 'border-pink-500/40 bg-pink-500/10',
		textColor: 'text-pink-700 dark:text-pink-300',
		icon: 'lucide:help-circle'
	},
	notation: {
		style: 'border-slate-400/40 bg-slate-400/10',
		textColor: 'text-slate-700 dark:text-slate-300',
		icon: 'lucide:pen-tool'
	},
	remark: {
		style: 'border-gray-400/40 bg-gray-400/10',
		textColor: 'text-gray-700 dark:text-gray-300',
		icon: 'lucide:message-circle'
	},
	intuition: {
		style: 'border-yellow-500/40 bg-yellow-500/10',
		textColor: 'text-yellow-700 dark:text-yellow-300',
		icon: 'lucide:lightbulb'
	},
	recall: {
		style: 'border-blue-300/40 bg-blue-300/10',
		textColor: 'text-blue-600 dark:text-blue-300',
		icon: 'lucide:rotate-ccw'
	},
	explanation: {
		style: 'border-lime-500/40 bg-lime-500/10',
		textColor: 'text-lime-700 dark:text-lime-300',
		icon: 'lucide:help-circle'
	},
	example: {
		style: 'border-emerald-500/40 bg-emerald-500/10',
		textColor: 'text-emerald-700 dark:text-emerald-300',
		icon: 'lucide:code'
	},
	exercise: {
		style: 'border-indigo-500/40 bg-indigo-500/10',
		textColor: 'text-indigo-700 dark:text-indigo-300',
		icon: 'lucide:dumbbell'
	},
	problem: {
		style: 'border-orange-600/40 bg-orange-600/10',
		textColor: 'text-orange-700 dark:text-orange-300',
		icon: 'lucide:alert-circle'
	},
	answer: {
		style: 'border-teal-500/40 bg-teal-500/10',
		textColor: 'text-teal-700 dark:text-teal-300',
		icon: 'lucide:check'
	},
	solution: {
		style: 'border-emerald-600/40 bg-emerald-600/10',
		textColor: 'text-emerald-700 dark:text-emerald-300',
		icon: 'lucide:check-circle-2'
	},
	summary: {
		style: 'border-sky-500/40 bg-sky-500/10',
		textColor: 'text-sky-700 dark:text-sky-300',
		icon: 'lucide:list'
	}
} as const

const capitalize = (str: string) => str.charAt(0).toUpperCase() + str.slice(1)

const stripLeadingEmoji = (value: string) =>
	value.replace(/^[^\p{L}\p{N}]+/u, '').trim()

const calloutVariants = cva(
	'not-prose relative my-6 rounded-2xl border p-4 text-sm',
	{
		variants: {
			variant: Object.fromEntries(
				Object.entries(calloutConfig).map(([key, config]) => [
					key,
					config.style
				])
			)
		},
		defaultVariants: {
			variant: 'note'
		}
	}
)

interface Props extends VariantProps<typeof calloutVariants> {
	title?: string
	class?: string
	variant?: keyof typeof calloutConfig
	defaultOpen?: boolean
}

const { title, variant = 'note', defaultOpen = true, ...rest } = Astro.props
const displayTitle = title ? stripLeadingEmoji(title) : capitalize(variant)
---

<details
	class={cn(
		calloutVariants({ variant }),
		rest.class,
		'[&[open]>summary_svg:last-child]:rotate-180 [&[open]>summary]:mb-3'
	)}
	{...rest}
	open={defaultOpen}
>
	<summary
		class="flex cursor-pointer items-center font-medium [&::-webkit-details-marker]:hidden"
	>
		<Icon
			name={calloutConfig[variant].icon}
			class={cn('mr-2 size-4 shrink-0', calloutConfig[variant].textColor)}
		/>
		<span class={cn('mr-2 font-medium', calloutConfig[variant].textColor)}>
			{displayTitle}
		</span>
		<Icon
			name="lucide:chevron-down"
			class={cn(
				'ml-auto h-4 w-4 shrink-0 transition-transform duration-200',
				calloutConfig[variant].textColor
			)}
		/>
	</summary>
	<div>
		<slot />
	</div>
</details>
