---
import type { CollectionEntry, CollectionKey } from 'astro:content'

import { SITE } from '@/consts'
import { isSubpost } from '@/lib/data-utils'
import { withBasePath } from '@/lib/utils'

interface Props<T extends CollectionKey> {
	post: CollectionEntry<T>
}

const { post } = Astro.props

const postData = post.data as typeof post.data & {
	description?: string
	image?: string | { src: string }
	name?: string
	title?: string
	date?: Date
	startDate?: Date
	authors?: string[]
	keywords?: string[]
	tags?: string[]
}
const title = postData.title ?? postData.name ?? SITE.title
const description = postData.description || SITE.description
const canonicalUrl = new URL(Astro.url.pathname, Astro.site)
const fallbackImage = '/static/twitter-card.png'
const imageSource =
	typeof postData.image === 'string' ? postData.image : postData.image?.src
const image = new URL(withBasePath(imageSource ?? fallbackImage), Astro.site)
const author =
	postData.authors && postData.authors.length > 0
		? postData.authors.join(', ')
		: SITE.author
const publishedDate = postData.date ?? postData.startDate
const keywords = Array.from(
	new Set([...(postData.tags ?? []), ...(postData.keywords ?? [])])
)
const structuredData = {
	'@context': 'https://schema.org',
	'@type': post.collection === 'blog' ? 'BlogPosting' : 'Article',
	headline: title,
	description,
	image: [image.toString()],
	url: canonicalUrl.toString(),
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl.toString()
	},
	author: {
		'@type': 'Person',
		name: author
	},
	publisher: {
		'@type': 'Organization',
		name: SITE.title,
		logo: {
			'@type': 'ImageObject',
			url: new URL(withBasePath('/static/logo.png'), Astro.site).toString()
		}
	},
	inLanguage: 'vi-VN',
	keywords: keywords.join(', '),
	...(publishedDate
		? {
				datePublished: publishedDate.toISOString(),
				dateModified: publishedDate.toISOString()
			}
		: {})
}
---

<title>{`${title} | ${SITE.title}`}</title>
<meta name="title" content={`${title} | ${SITE.title}`} />
<meta name="description" content={description} />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
<link rel="canonical" href={canonicalUrl.toString()} />

{isSubpost(post.id) && <meta name="robots" content="noindex" />}

<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image.toString()} />
<meta property="og:image:alt" content={title} />
<meta property="og:type" content="article" />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:url" content={canonicalUrl.toString()} />
<meta property="og:author" content={author} />

<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta property="twitter:image" content={image.toString()} />
<meta name="twitter:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:creator" content={author} />

{
	postData.tags &&
		postData.tags.map((tag: string) => {
			return <meta property="article:tag" content={tag} />
		})
}

<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(structuredData)}
/>
