---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'

interface Props {
	local: ImageMetadata | null
	src: string
	fullSrc: string
	alt: string
	title?: string
	description: string
	dateIso: string
	dateLabel: string
	/** Ảnh nằm ngay màn hình đầu: tải ngay thay vì lazy */
	eager?: boolean
}

const {
	local,
	src,
	fullSrc,
	alt,
	title,
	description,
	dateIso,
	dateLabel,
	eager = false
} = Astro.props

const imageClass =
	'block h-auto w-full transition-transform duration-300 group-hover:scale-[1.03]'
const loading = eager ? 'eager' : 'lazy'
const lightboxAttrs = {
	'data-lightbox-image': true,
	'data-lightbox-src': fullSrc,
	'data-lightbox-date': `Chụp ngày ${dateLabel}`,
	'data-lightbox-title': title,
	'data-lightbox-description': description
}
---

<li
	class="group relative mb-3 break-inside-avoid overflow-hidden rounded-xl border sm:mb-4"
>
	{
		local ? (
			<Image
				src={local}
				alt={alt}
				widths={[400, 600, 800]}
				sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, 50vw"
				format="webp"
				loading={loading}
				class={imageClass}
				{...lightboxAttrs}
			/>
		) : (
			<img
				src={src}
				alt={alt}
				loading={loading}
				decoding="async"
				class={imageClass}
				{...lightboxAttrs}
			/>
		)
	}
	<div
		class="pointer-events-none absolute inset-x-0 bottom-0 bg-linear-to-t from-black/70 to-transparent p-3 pt-8 text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100"
	>
		<time datetime={dateIso} class="flex items-center gap-1.5 text-xs">
			<Icon name="lucide:calendar" class="size-3.5" />
			{dateLabel}
		</time>
		{
			(title || description) && (
				<p class="mt-1 line-clamp-2 text-sm">{title || description}</p>
			)
		}
	</div>
</li>
